<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.PuntosController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Mis puntos" styleClass="subtitulo"/>
        <HBox spacing="24" styleClass="panel">
            <VBox spacing="2">
                <Label text="Vigentes"/>
                <Label fx:id="lblVigentes" styleClass="total"/>
            </VBox>
            <VBox spacing="2">
                <Label text="Vencidos"/>
                <Label fx:id="lblVencidos" styleClass="total"/>
            </VBox>
        </HBox>
        <Label text="Ganas 1 punto por cada $100 pagados con tarjeta. Los puntos vencen al año y se usan primero los más próximos a vencer."
               styleClass="ayuda" wrapText="true"/>
        <Label text="Acumulaciones" styleClass="subtitulo"/>
        <TableView fx:id="tablaAcumulaciones" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aún no tienes puntos"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colObtencion" text="Obtenidos el" prefWidth="100"/>
                <TableColumn fx:id="colIniciales" text="Puntos" prefWidth="70"/>
                <TableColumn fx:id="colDisponibles" text="Disponibles" prefWidth="85"/>
                <TableColumn fx:id="colVencimiento" text="Vencen el" prefWidth="100"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox spacing="10" prefWidth="380">
        <Label text="Redimir puntos" styleClass="subtitulo"/>

        <VBox spacing="6" styleClass="panel">
            <Label fx:id="lblCostoEntrada" styleClass="dato"/>
            <Label fx:id="lblEntrada" wrapText="true" styleClass="ayuda"/>
            <Button text="Canjear entrada" onAction="#canjearEntrada"/>
        </VBox>

        <VBox spacing="6" styleClass="panel">
            <Label fx:id="lblCostoProducto" styleClass="dato"/>
            <ComboBox fx:id="cmbProducto" promptText="Elige un producto" maxWidth="Infinity"/>
            <Button text="Canjear producto" onAction="#canjearProducto"/>
        </VBox>

        <VBox spacing="6" styleClass="panel">
            <Label fx:id="lblCostoCombo" styleClass="dato"/>
            <ComboBox fx:id="cmbCombo" promptText="Elige un combo" maxWidth="Infinity"/>
            <Button text="Canjear combo" onAction="#canjearCombo"/>
        </VBox>
    </VBox>
</HBox>
