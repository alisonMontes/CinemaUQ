<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.FuncionesAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Funciones" styleClass="subtitulo"/>
        <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="60"/>
                <TableColumn fx:id="colPelicula" text="Película" prefWidth="160"/>
                <TableColumn fx:id="colSala" text="Sala" prefWidth="80"/>
                <TableColumn fx:id="colFechaHora" text="Fecha y hora" prefWidth="120"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="75"/>
                <TableColumn fx:id="colOcupados" text="Vendidos" prefWidth="85"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="95"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Eliminar función" styleClass="btn-peligro" minWidth="-Infinity" onAction="#eliminar"/>
            <Label text="Solo se eliminan funciones sin compras; las demás se cancelan en la pestaña Cancelar función."
                   styleClass="ayuda" wrapText="true"/>
        </HBox>
    </VBox>

    <VBox spacing="6" prefWidth="300" styleClass="panel">
        <Label text="Nueva función" styleClass="subtitulo"/>
        <Label text="Código"/>
        <TextField fx:id="txtCodigo" promptText="F008"/>
        <Label text="Película"/>
        <ComboBox fx:id="cmbPelicula" promptText="Elige una película" maxWidth="Infinity"/>
        <Label text="Sala"/>
        <ComboBox fx:id="cmbSala" promptText="Elige una sala" maxWidth="Infinity"/>
        <Label text="Fecha"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
        <Label text="Hora (HH:mm)"/>
        <TextField fx:id="txtHora" promptText="19:30"/>
        <Label text="Precio base"/>
        <TextField fx:id="txtPrecio" promptText="18000"/>
        <Button styleClass="btn-primario" text="Crear función" maxWidth="Infinity" onAction="#crear">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
    </VBox>
</HBox>
