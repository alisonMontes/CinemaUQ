<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.CancelarFuncionAdminController"
      spacing="10">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Funciones" styleClass="subtitulo"/>
    <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="60"/>
            <TableColumn fx:id="colPelicula" text="Película" prefWidth="200"/>
            <TableColumn fx:id="colSala" text="Sala" prefWidth="90"/>
            <TableColumn fx:id="colFechaHora" text="Fecha y hora" prefWidth="130"/>
            <TableColumn fx:id="colVendidos" text="Asientos vendidos" prefWidth="135"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button styleClass="btn-peligro" minWidth="-Infinity" fx:id="btnCancelar" text="Cancelar función" disable="true" onAction="#cancelarFuncion"/>
        <Label text="Si el cine cancela la función se devuelve el 100 % de las compras pagadas con tarjeta."
               styleClass="ayuda" wrapText="true"/>
    </HBox>

    <Label text="Resultado de la última cancelación" styleClass="subtitulo"/>
    <Label fx:id="lblResultado" styleClass="dato" wrapText="true"/>
    <TableView fx:id="tablaReembolsos" prefHeight="180">
        <placeholder>
            <Label text="Aún no se ha cancelado ninguna función en esta sesión"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCompra" text="Compra" prefWidth="80"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="220"/>
            <TableColumn fx:id="colPagado" text="Pagado" prefWidth="110"/>
            <TableColumn fx:id="colReembolsado" text="Reembolsado" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
</VBox>
