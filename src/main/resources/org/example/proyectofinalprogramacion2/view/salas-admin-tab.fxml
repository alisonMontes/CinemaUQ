<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.SalasAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Salas" styleClass="subtitulo"/>
        <TableView fx:id="tablaSalas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSalaCodigo" text="Código" prefWidth="70"/>
                <TableColumn fx:id="colSalaNombre" text="Nombre" prefWidth="150"/>
                <TableColumn fx:id="colSalaCapacidad" text="Asientos" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <VBox spacing="6" styleClass="panel">
            <Label text="Nueva sala" styleClass="dato"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtSalaCodigo" promptText="Código (S04)" prefWidth="110"/>
                <TextField fx:id="txtSalaNombre" promptText="Nombre" HBox.hgrow="ALWAYS"/>
                <Button text="Crear sala" minWidth="-Infinity" onAction="#crearSala"/>
            </HBox>
        </VBox>
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
    </VBox>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label fx:id="lblSalaElegida" styleClass="subtitulo"/>
        <TableView fx:id="tablaAsientos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAsientoCodigo" text="Asiento" prefWidth="70"/>
                <TableColumn fx:id="colAsientoFila" text="Fila" prefWidth="60"/>
                <TableColumn fx:id="colAsientoNumero" text="Número" prefWidth="70"/>
                <TableColumn fx:id="colAsientoTipo" text="Tipo" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <VBox spacing="6" styleClass="panel">
            <Label text="Agregar asiento a la sala seleccionada" styleClass="dato"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtFila" promptText="Fila (A)" prefWidth="80"/>
                <TextField fx:id="txtNumero" promptText="Número" prefWidth="80"/>
                <ComboBox fx:id="cmbTipo" prefWidth="120"/>
                <Button text="Agregar" minWidth="-Infinity" onAction="#agregarAsiento"/>
                <Button text="Eliminar seleccionado" styleClass="boton-secundario" minWidth="-Infinity"
                        onAction="#eliminarAsiento"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
