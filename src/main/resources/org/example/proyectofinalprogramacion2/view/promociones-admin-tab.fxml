<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.PromocionesAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Promociones" styleClass="subtitulo"/>
        <TableView fx:id="tablaPromociones" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="colPorcentaje" text="Descuento" prefWidth="90"/>
                <TableColumn fx:id="colInicio" text="Desde" prefWidth="95"/>
                <TableColumn fx:id="colFin" text="Hasta" prefWidth="95"/>
                <TableColumn fx:id="colVigente" text="Vigente hoy" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox spacing="6" prefWidth="300" styleClass="panel">
        <Label text="Nueva promoción" styleClass="subtitulo"/>
        <Label text="Código"/>
        <TextField fx:id="txtCodigo" promptText="PM05"/>
        <Label text="Nombre"/>
        <TextField fx:id="txtNombre"/>
        <Label text="Porcentaje de descuento"/>
        <TextField fx:id="txtPorcentaje" promptText="15"/>
        <Label text="Vigente desde"/>
        <DatePicker fx:id="dpInicio" maxWidth="Infinity"/>
        <Label text="Vigente hasta (inclusive)"/>
        <DatePicker fx:id="dpFin" maxWidth="Infinity"/>
        <Button styleClass="btn-primario" text="Crear promoción" maxWidth="Infinity" onAction="#crear">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
    </VBox>
</HBox>
