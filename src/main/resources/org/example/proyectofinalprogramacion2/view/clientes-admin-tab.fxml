<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.ClientesAdminController"
      spacing="10">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Clientes" styleClass="subtitulo"/>
    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="190"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190"/>
            <TableColumn fx:id="colTarjeta" text="Tarjeta" prefWidth="90"/>
            <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="100"/>
            <TableColumn fx:id="colEstadoTarjeta" text="Estado tarjeta" prefWidth="115"/>
            <TableColumn fx:id="colCompras" text="Compras" prefWidth="70"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblComprasDe" styleClass="subtitulo"/>
    <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Sin compras"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCompraCodigo" text="Código" prefWidth="70"/>
            <TableColumn fx:id="colCompraFecha" text="Fecha" prefWidth="115"/>
            <TableColumn fx:id="colCompraFuncion" text="Función" prefWidth="210"/>
            <TableColumn fx:id="colCompraDetalle" text="Detalle" prefWidth="260"/>
            <TableColumn fx:id="colCompraTotal" text="Total" prefWidth="80"/>
            <TableColumn fx:id="colCompraPago" text="Pago" prefWidth="95"/>
            <TableColumn fx:id="colCompraEstado" text="Estado" prefWidth="160"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
</VBox>
