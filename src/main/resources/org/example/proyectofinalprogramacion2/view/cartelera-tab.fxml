<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.CarteleraController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Películas en cartelera" styleClass="subtitulo"/>
        <TableView fx:id="tablaPeliculas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="170"/>
                <TableColumn fx:id="colGenero" text="Género" prefWidth="110"/>
                <TableColumn fx:id="colDuracion" text="Duración" prefWidth="80"/>
                <TableColumn fx:id="colClasificacion" text="Clasificación" prefWidth="105"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <Label fx:id="lblSinopsis" wrapText="true" styleClass="ayuda"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Funciones disponibles" styleClass="subtitulo"/>
        <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No hay funciones disponibles para esta película"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colFechaHora" text="Fecha y hora" prefWidth="130"/>
                <TableColumn fx:id="colSala" text="Sala" prefWidth="90"/>
                <TableColumn fx:id="colPrecio" text="Entrada" prefWidth="80"/>
                <TableColumn fx:id="colDisponibles" text="Asientos libres" prefWidth="115"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button styleClass="btn-primario" minWidth="-Infinity" text="Elegir función" onAction="#elegirFuncion"/>
            <Label fx:id="lblMensaje" styleClass="mensaje-error"/>
        </HBox>
    </VBox>
</HBox>
