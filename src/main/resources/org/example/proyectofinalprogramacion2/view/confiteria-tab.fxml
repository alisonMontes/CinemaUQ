<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.ConfiteriaController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Productos" styleClass="subtitulo"/>
        <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProductoNombre" text="Producto" prefWidth="140"/>
                <TableColumn fx:id="colProductoDescripcion" text="Descripción" prefWidth="160"/>
                <TableColumn fx:id="colProductoPrecio" text="Precio" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <Button text="Agregar producto" onAction="#agregarProducto"/>

        <Label text="Combos" styleClass="subtitulo"/>
        <TableView fx:id="tablaCombos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colComboNombre" text="Combo" prefWidth="130"/>
                <TableColumn fx:id="colComboContenido" text="Contenido" prefWidth="200"/>
                <TableColumn fx:id="colComboPrecio" text="Precio" prefWidth="80"/>
                <TableColumn fx:id="colComboAhorro" text="Ahorro" prefWidth="70"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <Button text="Agregar combo" onAction="#agregarCombo"/>
    </VBox>

    <VBox spacing="8" prefWidth="340">
        <Label text="Tu carrito de confitería" styleClass="subtitulo"/>
        <TableView fx:id="tablaCarrito" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aún no agregas productos ni combos"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colItemNombre" text="Ítem" prefWidth="200"/>
                <TableColumn fx:id="colItemPrecio" text="Precio" prefWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <Label fx:id="lblMensaje" styleClass="mensaje-error"/>
        <HBox spacing="10">
            <Button text="Quitar" styleClass="boton-secundario" onAction="#quitarItem"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Ir al resumen" onAction="#irAResumen"/>
        </HBox>
    </VBox>
</HBox>
