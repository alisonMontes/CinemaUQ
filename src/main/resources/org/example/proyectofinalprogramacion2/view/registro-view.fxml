<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.RegistroController"
      alignment="CENTER" spacing="14" prefWidth="440" prefHeight="590">
    <padding>
        <Insets top="24" right="40" bottom="24" left="40"/>
    </padding>

    <Label text="CinemaUQ" styleClass="titulo"/>
    <Label text="Registro de cliente" styleClass="subtitulo"/>

    <VBox spacing="8" styleClass="panel, tarjeta-login" maxWidth="340">
        <Label text="Nombre completo"/>
        <TextField fx:id="txtNombre"/>
        <Label text="Correo"/>
        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"/>
        <Label text="Clave"/>
        <PasswordField fx:id="txtClave"/>
        <Label text="Confirmar clave"/>
        <PasswordField fx:id="txtConfirmacion"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
            <Button text="Volver" styleClass="btn-secundario" minWidth="-Infinity" cancelButton="true" onAction="#volver"/>
            <Button styleClass="btn-primario" minWidth="-Infinity" text="Registrarme" defaultButton="true" onAction="#registrar"/>
        </HBox>
        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" minHeight="36">
            <VBox.margin>
                <Insets top="4"/>
            </VBox.margin>
        </Label>
    </VBox>
</VBox>
