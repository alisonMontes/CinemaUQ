<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.LoginController"
      alignment="CENTER" spacing="14" prefWidth="420" prefHeight="420">
    <padding>
        <Insets top="24" right="40" bottom="24" left="40"/>
    </padding>

    <Label text="CinemaUQ" styleClass="titulo"/>
    <Label text="Iniciar sesión" styleClass="subtitulo"/>

    <VBox spacing="6" styleClass="panel">
        <Label text="Correo"/>
        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"/>
        <Label text="Clave"/>
        <PasswordField fx:id="txtClave"/>
        <Button text="Ingresar" defaultButton="true" maxWidth="Infinity" onAction="#iniciarSesion">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>
    </VBox>

    <Hyperlink text="¿No tienes cuenta? Regístrate" onAction="#irARegistro"/>
</VBox>
