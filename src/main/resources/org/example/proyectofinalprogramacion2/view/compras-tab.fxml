<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.ComprasController"
      spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Mis compras" styleClass="subtitulo"/>
    <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Aún no tienes compras"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="70"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="115"/>
            <TableColumn fx:id="colFuncion" text="Función" prefWidth="210"/>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="260"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="80"/>
            <TableColumn fx:id="colPago" text="Pago" prefWidth="95"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="160"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>
    <Label text="Cancelación: más de 24 h antes de la función, 100 %; entre 2 y 24 h, 80 %; menos de 2 h, no se permite. Los canjes con puntos no se cancelan."
           styleClass="ayuda" wrapText="true"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button styleClass="btn-peligro" minWidth="-Infinity" fx:id="btnCancelar" text="Cancelar compra" disable="true" onAction="#cancelarCompra"/>
        <Label fx:id="lblMensaje" styleClass="mensaje-error"/>
    </HBox>
</VBox>
