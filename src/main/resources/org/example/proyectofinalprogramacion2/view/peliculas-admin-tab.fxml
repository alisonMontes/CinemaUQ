<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.PeliculasAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Películas" styleClass="subtitulo"/>
        <TableView fx:id="tablaPeliculas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="60"/>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="170"/>
                <TableColumn fx:id="colGenero" text="Género" prefWidth="110"/>
                <TableColumn fx:id="colDuracion" text="Duración" prefWidth="80"/>
                <TableColumn fx:id="colClasificacion" text="Clasificación" prefWidth="105"/>
                <TableColumn fx:id="colEnCartelera" text="En cartelera" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox spacing="6" prefWidth="330" styleClass="panel">
        <Label text="Datos de la película" styleClass="subtitulo"/>
        <Label text="Código"/>
        <TextField fx:id="txtCodigo" promptText="P005"/>
        <Label text="Título"/>
        <TextField fx:id="txtTitulo"/>
        <Label text="Género"/>
        <TextField fx:id="txtGenero"/>
        <Label text="Duración (minutos)"/>
        <TextField fx:id="txtDuracion"/>
        <Label text="Clasificación"/>
        <TextField fx:id="txtClasificacion" promptText="+12"/>
        <Label text="Sinopsis"/>
        <TextArea fx:id="txtSinopsis" prefRowCount="3" wrapText="true"/>
        <CheckBox fx:id="chkEnCartelera" text="En cartelera" selected="true"/>
        <FlowPane hgap="8" vgap="8">
            <Button text="Nueva" styleClass="btn-secundario" minWidth="-Infinity" onAction="#nueva"/>
            <Button styleClass="btn-primario" minWidth="-Infinity" text="Crear" onAction="#crear"/>
            <Button styleClass="btn-primario" minWidth="-Infinity" text="Guardar cambios" onAction="#guardar"/>
            <Button text="Eliminar" styleClass="btn-peligro" minWidth="-Infinity" onAction="#eliminar"/>
        </FlowPane>
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
    </VBox>
</HBox>
