<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.CatalogoAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Productos" styleClass="subtitulo"/>
        <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProductoCodigo" text="Código" prefWidth="60"/>
                <TableColumn fx:id="colProductoNombre" text="Nombre" prefWidth="140"/>
                <TableColumn fx:id="colProductoPrecio" text="Precio" prefWidth="75"/>
                <TableColumn fx:id="colProductoDescripcion" text="Descripción" prefWidth="160"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <VBox spacing="6" styleClass="panel">
            <Label text="Nuevo producto" styleClass="dato"/>
            <HBox spacing="8">
                <TextField fx:id="txtProductoCodigo" promptText="Código (PR07)" prefWidth="110"/>
                <TextField fx:id="txtProductoNombre" promptText="Nombre" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtProductoPrecio" promptText="Precio" prefWidth="90"/>
            </HBox>
            <HBox spacing="8">
                <TextField fx:id="txtProductoDescripcion" promptText="Descripción" HBox.hgrow="ALWAYS"/>
                <Button text="Crear producto" minWidth="-Infinity" onAction="#crearProducto"/>
            </HBox>
        </VBox>
        <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
    </VBox>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Combos" styleClass="subtitulo"/>
        <TableView fx:id="tablaCombos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colComboCodigo" text="Código" prefWidth="60"/>
                <TableColumn fx:id="colComboNombre" text="Nombre" prefWidth="120"/>
                <TableColumn fx:id="colComboContenido" text="Componentes" prefWidth="170"/>
                <TableColumn fx:id="colComboDescuento" text="Desc." prefWidth="55"/>
                <TableColumn fx:id="colComboPrecio" text="Precio" prefWidth="75"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <VBox spacing="6" styleClass="panel">
            <Label text="Nuevo combo" styleClass="dato"/>
            <HBox spacing="8">
                <TextField fx:id="txtComboCodigo" promptText="Código (CB04)" prefWidth="110"/>
                <TextField fx:id="txtComboNombre" promptText="Nombre" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtComboDescuento" promptText="Descuento %" prefWidth="100"/>
            </HBox>
            <HBox spacing="8">
                <ComboBox fx:id="cmbComponente" promptText="Producto o combo" HBox.hgrow="ALWAYS"
                          maxWidth="Infinity"/>
                <Button text="Agregar" minWidth="-Infinity" onAction="#agregarComponente"/>
                <Button text="Quitar" styleClass="boton-secundario" minWidth="-Infinity"
                        onAction="#quitarComponente"/>
            </HBox>
            <ListView fx:id="listaComponentes" prefHeight="90">
                <placeholder>
                    <Label text="Agrega los componentes del combo"/>
                </placeholder>
            </ListView>
            <Button text="Crear combo" onAction="#crearCombo"/>
        </VBox>
    </VBox>
</HBox>
