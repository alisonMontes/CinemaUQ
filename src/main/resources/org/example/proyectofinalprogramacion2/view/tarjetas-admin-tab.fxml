<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.TarjetasAdminController"
      spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="10" prefWidth="460">
        <Label text="Tarjetas de los clientes" styleClass="subtitulo"/>
        <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Cliente" prefWidth="170"/>
                <TableColumn fx:id="colTarjeta" text="Tarjeta" prefWidth="80"/>
                <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="90"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <VBox spacing="10" styleClass="panel">
            <Label fx:id="lblClienteElegido" styleClass="dato" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtMonto" promptText="Monto a recargar" prefWidth="150"/>
                <Button styleClass="btn-primario" minWidth="-Infinity" text="Recargar" onAction="#recargar"/>
            </HBox>
            <HBox spacing="10">
                <Button styleClass="btn-primario" minWidth="-Infinity" text="Activar tarjeta" onAction="#activar"/>
                <Button text="Bloquear tarjeta" styleClass="btn-peligro" minWidth="-Infinity" onAction="#bloquear"/>
            </HBox>
            <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
        </VBox>
        <Label text="Movimientos" styleClass="subtitulo"/>
        <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Sin movimientos"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="115"/>
                <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="85"/>
                <TableColumn fx:id="colMovMonto" text="Monto" prefWidth="85"/>
                <TableColumn fx:id="colMovDescripcion" text="Descripción" prefWidth="260"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
