<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalprogramacion2.controller.ReportesAdminController"
      spacing="10">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel">
        <Label text="Reporte"/>
        <ComboBox fx:id="cmbTipo" prefWidth="250"/>
        <Label text="Desde"/>
        <DatePicker fx:id="dpDesde" prefWidth="130"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="dpHasta" prefWidth="130"/>
        <Button styleClass="btn-primario" minWidth="-Infinity" text="Generar" onAction="#generar"/>
        <Button styleClass="btn-secundario" minWidth="-Infinity" text="Exportar TXT" onAction="#exportar"/>
    </HBox>

    <TextArea fx:id="txtReporte" styleClass="texto-reporte" editable="false" VBox.vgrow="ALWAYS"
              promptText="Elige el reporte y el periodo y pulsa Generar."/>
    <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true"/>
</VBox>
