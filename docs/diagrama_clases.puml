        + setTarjeta(tarjeta : TarjetaVirtual) : void
        + getCuentaPuntos() : CuentaPuntos
        + getCompras() : List<Compra>
        + toString() : String
    }

    class Administrador {
        + Administrador(nombre : String, correo : String, clave : String)
        + getRol() : String
    }

