@startuml CinemaUQ
title CinemaUQ - Diagrama de clases
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package model {

    abstract class Usuario {
        - nombre : String
        - correo : String
        - clave : String
        # Usuario(nombre : String, correo : String, clave : String)
        + verificarClave(clave : String) : boolean
        + {abstract} getRol() : String
        + getNombre() : String
        + setNombre(nombre : String) : void
        + getCorreo() : String
        + setCorreo(correo : String) : void
        + getClave() : String
        + setClave(clave : String) : void
        + equals(o : Object) : boolean
        + hashCode() : int
        + toString() : String
    }

    class Cliente {
        - tarjeta : TarjetaVirtual
        - cuentaPuntos : CuentaPuntos
        - compras : List<Compra>
        - notificaciones : List<String>
