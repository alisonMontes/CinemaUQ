    class Sala {
        - codigo : String
        - nombre : String
        - asientos : List<Asiento>
        + Sala(codigo : String, nombre : String)
        + agregarAsiento(asiento : Asiento) : void
        + eliminarAsiento(asiento : Asiento) : boolean
        + buscarAsiento(fila : String, numero : int) : Asiento
        + contieneAsiento(asiento : Asiento) : boolean
        + getCapacidad() : int
        + getCodigo() : String
        + setCodigo(codigo : String) : void
        + getNombre() : String
        + setNombre(nombre : String) : void
        + getAsientos() : List<Asiento>
        + toString() : String
    }

    class Asiento {
