        - validarSinCruce(sala : Sala, pelicula : Pelicula, inicio : LocalDateTime, actual : Funcion) : void
    }
    class EstadisticaService {
        - cinema : CinemaUQ
        + getComprasEnPeriodo(desde : LocalDate, hasta : LocalDate) : List<Compra>
        + getIngresosNetos(desde : LocalDate, hasta : LocalDate) : double
        + getVentasPorDia(desde : LocalDate, hasta : LocalDate) : Map<LocalDate, Double>
        + getOcupacionPorFuncion() : Map<Funcion, Double>
        + getOcupacionPorSala() : Map<Sala, Double>
        + getEntradasPorPelicula() : Map<Pelicula, Integer>
        + getProductosMasVendidos() : Map<Producto, Integer>
        + getCombosMasVendidos() : Map<Combo, Integer>
        + getComprasReembolsadas(desde : LocalDate, hasta : LocalDate) : List<Compra>
        + getTotalReembolsado(desde : LocalDate, hasta : LocalDate) : double
        + getPuntosRedimidos(desde : LocalDate, hasta : LocalDate) : int
    }
    class DatosIniciales <<final>> {
        + {static} CORREO_ADMIN : String
        + {static} CLAVE_ADMIN : String
        + {static} cargar(ahora : LocalDateTime) : void
    }
