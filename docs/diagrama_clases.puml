        + setTipo(tipo : TipoAsiento) : void
        + toString() : String
    }

    class Funcion {
        - codigo : String
        - pelicula : Pelicula
        - sala : Sala
        - fecha : LocalDate
        - hora : LocalTime
        - precioBase : double
        - estado : EstadoFuncion
        - asientosOcupados : List<Asiento>
        - observadores : List<ObservadorFuncion>
        + Funcion(codigo : String, pelicula : Pelicula, sala : Sala, fecha : LocalDate, hora : LocalTime, precioBase : double)
        + agregarObservador(o : ObservadorFuncion) : void
        + eliminarObservador(o : ObservadorFuncion) : boolean
        + notificarObservadores(mensaje : String) : void
        + cancelar() : void
        + getObservadores() : List<ObservadorFuncion>
        + getFechaHora() : LocalDateTime
        + estaDisponible(asiento : Asiento) : boolean
        + ocuparAsiento(asiento : Asiento) : void
        + liberarAsiento(asiento : Asiento) : boolean
        + getAsientosDisponibles() : List<Asiento>
        + getCodigo() : String
        + getPelicula() : Pelicula
        + getSala() : Sala
        + getFecha() : LocalDate
        + getHora() : LocalTime
        + getPrecioBase() : double
        + getEstado() : EstadoFuncion
        + setEstado(estado : EstadoFuncion) : void
        + getAsientosOcupados() : List<Asiento>
        + estaDisponibleParaVenta(ahora : LocalDateTime) : boolean
        + toString() : String
    }

    interface ItemVendible {
        + getNombre() : String
        + getPrecio() : double
    }

    abstract class Entrada {
        - funcion : Funcion
        - asiento : Asiento
        # Entrada(funcion : Funcion, asiento : Asiento)
        + {abstract} getTipo() : String
        + getNombre() : String
        + getPrecio() : double
        + getFuncion() : Funcion
        + setFuncion(funcion : Funcion) : void
        + getAsiento() : Asiento
        + setAsiento(asiento : Asiento) : void
        + toString() : String
    }

    class EntradaGeneral {
        + EntradaGeneral(funcion : Funcion, asiento : Asiento)
        + getTipo() : String
    }

    class EntradaAccesible {
        + EntradaAccesible(funcion : Funcion, asiento : Asiento)
        + getTipo() : String
    }

    class Producto {
        - codigo : String
        - nombre : String
        - precio : double
        - descripcion : String
        + Producto(codigo : String, nombre : String, precio : double, descripcion : String)
        + getCodigo() : String
        + getNombre() : String
        + setNombre(nombre : String) : void
        + getPrecio() : double
        + setPrecio(precio : double) : void
        + getDescripcion() : String
        + setDescripcion(descripcion : String) : void
        + toString() : String
    }

    class Combo {
        - codigo : String
        - nombre : String
        - porcentajeDescuento : double
        - componentes : List<ItemVendible>
        + Combo(codigo : String, nombre : String, porcentajeDescuento : double)
        + agregarComponente(c : ItemVendible) : void
        + eliminarComponente(c : ItemVendible) : boolean
        + getPrecioRegular() : double
        + getPrecio() : double
        + getAhorro() : double
        + getCodigo() : String
        + getNombre() : String
        + setNombre(nombre : String) : void
        + getPorcentajeDescuento() : double
        + setPorcentajeDescuento(p : double) : void
        + getComponentes() : List<ItemVendible>
        + toString() : String
    }

    class Promocion {
        - codigo : String
        - nombre : String
        - porcentajeDescuento : double
        - fechaInicio : LocalDate
        - fechaFin : LocalDate
        + Promocion(codigo : String, nombre : String, porcentajeDescuento : double, fechaInicio : LocalDate, fechaFin : LocalDate)
        + estaVigente(hoy : LocalDate) : boolean
        + calcularDescuento(monto : double) : double
        + getCodigo() : String
        + getNombre() : String
        + getPorcentajeDescuento() : double
        + setPorcentajeDescuento(porcentaje : double) : void
        + getFechaInicio() : LocalDate
        + setFechaInicio(fecha : LocalDate) : void
        + getFechaFin() : LocalDate
        + setFechaFin(fecha : LocalDate) : void
        + toString() : String
    }

    class Compra {
        - codigo : String
        - cliente : Cliente
        - funcion : Funcion
        - entradas : List<Entrada>
        - productos : List<Producto>
        - combos : List<Combo>
        - promocion : Promocion
        - total : double
        - fecha : LocalDateTime
        - pagadaConPuntos : boolean
        - estado : EstadoCompraState
        - medioPago : MedioPago
        - puntosUsados : int
        - montoReembolsado : double
        - Compra(builder : Builder, total : double)
        + confirmarPago(medioPago : MedioPago) : void
        + confirmarCanje(puntosUsados : int) : void
        + reembolsar(estrategia : ReembolsoStrategy) : double
        ~ cambiarEstado(nuevo : EstadoCompraState) : void
        ~ setMontoReembolsado(monto : double) : void
        + getItems() : List<ItemVendible>
        + calcularSubtotal() : double
        + getDescuento() : double
        + getEstado() : EstadoCompra
        + getCodigo() : String
        + getCliente() : Cliente
        + getFuncion() : Funcion
        + getEntradas() : List<Entrada>
        + getProductos() : List<Producto>
        + getCombos() : List<Combo>
        + getPromocion() : Promocion
        + getTotal() : double
        + getFecha() : LocalDateTime
        + isPagadaConPuntos() : boolean
        + getMedioPago() : MedioPago
        + getPuntosUsados() : int
        + getMontoReembolsado() : double
        + toString() : String
    }

    class "Compra.Builder" as CompraBuilder {
        - codigo : String
        - cliente : Cliente
        - fecha : LocalDateTime
        - funcion : Funcion
        - entradas : List<Entrada>
        - productos : List<Producto>
        - combos : List<Combo>
        - promocion : Promocion
        - pagadaConPuntos : boolean
        + Builder(codigo : String, cliente : Cliente, fecha : LocalDateTime)
        + funcion(f : Funcion) : Builder
        + agregarEntrada(e : Entrada) : Builder
        + agregarProducto(p : Producto) : Builder
        + agregarCombo(c : Combo) : Builder
        + promocion(p : Promocion) : Builder
        + pagadaConPuntos(valor : boolean) : Builder
        + build() : Compra
    }

    interface EstadoCompraState {
        + getValor() : EstadoCompra
        + pagar(compra : Compra) : void
        + reembolsar(compra : Compra, estrategia : ReembolsoStrategy) : double
    }

    class CompraPendiente {
        + getValor() : EstadoCompra
        + pagar(compra : Compra) : void
        + reembolsar(compra : Compra, estrategia : ReembolsoStrategy) : double
    }

    class CompraPagada {
        + getValor() : EstadoCompra
        + pagar(compra : Compra) : void
        + reembolsar(compra : Compra, estrategia : ReembolsoStrategy) : double
    }

    class CompraReembolsada {
        + getValor() : EstadoCompra
        + pagar(compra : Compra) : void
        + reembolsar(compra : Compra, estrategia : ReembolsoStrategy) : double
    }

    class CuentaPuntos {
        - acumulaciones : List<AcumulacionPuntos>
        + CuentaPuntos()
        + agregarAcumulacion(acumulacion : AcumulacionPuntos) : void
        + getAcumulacionesVigentes(hoy : LocalDate) : List<AcumulacionPuntos>
        + anularPuntosDe(compra : Compra) : boolean
        + getPuntosDisponibles(hoy : LocalDate) : int
        + getAcumulaciones() : List<AcumulacionPuntos>
        + toString() : String
    }

    class AcumulacionPuntos {
        - puntosIniciales : int
        - puntosDisponibles : int
        - fechaObtencion : LocalDate
        - fechaVencimiento : LocalDate
        - compraOrigen : Compra
        - anulada : boolean
        + AcumulacionPuntos(puntosIniciales : int, fechaObtencion : LocalDate, compraOrigen : Compra)
        + estaVencida(hoy : LocalDate) : boolean
        + estaSinUsar() : boolean
        + getPuntosIniciales() : int
        + getPuntosDisponibles() : int
        + setPuntosDisponibles(puntos : int) : void
        + getFechaObtencion() : LocalDate
        + getFechaVencimiento() : LocalDate
        + getCompraOrigen() : Compra
        + isAnulada() : boolean
        + setAnulada(anulada : boolean) : void
        + toString() : String
    }

    class ConfiguracionPuntos <<final>> {
        + {static} PESOS_POR_PUNTO : double = 100
        + {static} ANIOS_VIGENCIA : int = 1
        + {static} PUNTOS_ENTRADA : int = 1000
        + {static} PUNTOS_PRODUCTO : int = 400
        + {static} PUNTOS_COMBO : int = 1200
        - ConfiguracionPuntos()
        + {static} calcularPuntos(montoPagado : double) : int
    }

    class CinemaUQ <<Singleton>> {
        - {static} instancia : CinemaUQ
        - nombre : String
        - consecutivoCompras : int
        - consecutivoTarjetas : int
        - usuarios : List<Usuario>
        - peliculas : List<Pelicula>
        - salas : List<Sala>
        - funciones : List<Funcion>
        - productos : List<Producto>
        - combos : List<Combo>
        - promociones : List<Promocion>
        - compras : List<Compra>
        - CinemaUQ()
        + {static} getInstancia() : CinemaUQ
        + reiniciar() : void
        + generarCodigoCompra() : String
        + generarNumeroTarjeta() : String
        + agregarUsuario(usuario : Usuario) : void
        + buscarUsuarioPorCorreo(correo : String) : Usuario
        + getClientes() : List<Cliente>
        + getAdministradores() : List<Administrador>
        + agregarPelicula(p : Pelicula) : void
        + eliminarPelicula(p : Pelicula) : boolean
        + buscarPelicula(codigo : String) : Pelicula
        + agregarSala(s : Sala) : void
        + eliminarSala(s : Sala) : boolean
        + buscarSala(codigo : String) : Sala
        + agregarFuncion(f : Funcion) : void
        + eliminarFuncion(f : Funcion) : boolean
        + buscarFuncion(codigo : String) : Funcion
        + agregarProducto(p : Producto) : void
        + eliminarProducto(p : Producto) : boolean
        + buscarProducto(codigo : String) : Producto
        + agregarCombo(c : Combo) : void
        + eliminarCombo(c : Combo) : boolean
        + buscarCombo(codigo : String) : Combo
        + agregarPromocion(p : Promocion) : void
        + eliminarPromocion(p : Promocion) : boolean
        + buscarPromocion(codigo : String) : Promocion
        + agregarCompra(c : Compra) : void
        + buscarCompra(codigo : String) : Compra
        + getNombre() : String
        + getUsuarios() : List<Usuario>
        + getPeliculas() : List<Pelicula>
        + getSalas() : List<Sala>
        + getFunciones() : List<Funcion>
        + getProductos() : List<Producto>
        + getCombos() : List<Combo>
        + getPromociones() : List<Promocion>
        + getCompras() : List<Compra>
        + toString() : String
    }

    enum EstadoTarjeta {
        ACTIVA
        BLOQUEADA
    }

    enum TipoMovimiento {
        RECARGA
        PAGO
        REEMBOLSO
    }

    enum TipoAsiento {
        NORMAL
        ACCESIBLE
    }

    enum EstadoFuncion {
        PROGRAMADA
        CANCELADA
        FINALIZADA
    }

    enum EstadoCompra {
        PENDIENTE
        PAGADA
        REEMBOLSADA
    }
}

package factory {
    abstract class EntradaFactory {
        + {abstract} crearEntrada(funcion : Funcion, asiento : Asiento) : Entrada
        + {static} segunAsiento(asiento : Asiento) : EntradaFactory
    }
    class EntradaGeneralFactory {
        + crearEntrada(funcion : Funcion, asiento : Asiento) : Entrada
    }
    class EntradaAccesibleFactory {
        + crearEntrada(funcion : Funcion, asiento : Asiento) : Entrada
    }
}

package decorator {
    class PromocionDecorator {
        - item : ItemVendible
        - promocion : Promocion
        - fecha : LocalDate
        + PromocionDecorator(item : ItemVendible, promocion : Promocion, fecha : LocalDate)
        + aplicaDescuento() : boolean
        + getNombre() : String
        + getPrecio() : double
        + getItem() : ItemVendible
        + getPromocion() : Promocion
        + toString() : String
    }
}

package adapter {
    interface MedioPago {
        + validarPago(monto : double) : void
        + cobrar(monto : double, concepto : String, fecha : LocalDateTime) : void
        + reembolsar(monto : double, concepto : String, fecha : LocalDateTime) : void
        + getDescripcion() : String
    }
    class PagoTarjetaAdapter {
        - tarjeta : TarjetaVirtual
        + PagoTarjetaAdapter(tarjeta : TarjetaVirtual)
        + validarPago(monto : double) : void
        + cobrar(monto : double, concepto : String, fecha : LocalDateTime) : void
        + reembolsar(monto : double, concepto : String, fecha : LocalDateTime) : void
        + getDescripcion() : String
        + getTarjeta() : TarjetaVirtual
    }
}

package strategy {
    interface ReembolsoStrategy {
        + calcularReembolso(totalPagado : double) : double
        + getDescripcion() : String
    }
    class ReembolsoCompleto {
        + calcularReembolso(totalPagado : double) : double
        + getDescripcion() : String
    }
    class ReembolsoParcial {
        + {static} PORCENTAJE : double = 80
        + calcularReembolso(totalPagado : double) : double
        + getDescripcion() : String
    }
    class SinReembolso {
        + calcularReembolso(totalPagado : double) : double
        + getDescripcion() : String
    }
    class SelectorReembolso {
        + {static} LIMITE_REEMBOLSO_COMPLETO : Duration
        + {static} LIMITE_REEMBOLSO_PARCIAL : Duration
        + seleccionar(funcion : Funcion, ahora : LocalDateTime) : ReembolsoStrategy
    }
}

package observer {
    interface ObservadorFuncion {
        + actualizar(funcion : Funcion, mensaje : String) : void
    }
}

package facade {
    class ProcesoCompraFacade {
        - cinema : CinemaUQ
        - selectorReembolso : SelectorReembolso
        + ProcesoCompraFacade()
        + ProcesoCompraFacade(cinema : CinemaUQ, selector : SelectorReembolso)
        + comprar(compra : Compra, medioPago : MedioPago, ahora : LocalDateTime) : Compra
        + cancelarCompra(compra : Compra, ahora : LocalDateTime) : double
        + cancelarFuncion(funcion : Funcion, ahora : LocalDateTime) : List<Compra>
        - reembolsar(compra : Compra, estrategia : ReembolsoStrategy, ahora : LocalDateTime) : double
        - validarFuncionDisponible(funcion : Funcion, ahora : LocalDateTime) : void
        - validarAsientos(compra : Compra) : void
        - acumularPuntos(compra : Compra, ahora : LocalDateTime) : void
    }
}

