        + setTipo(tipo : TipoMovimiento) : void
        + getFecha() : LocalDateTime
        + setFecha(fecha : LocalDateTime) : void
        + getMonto() : double
        + setMonto(monto : double) : void
        + getDescripcion() : String
        + setDescripcion(descripcion : String) : void
        + toString() : String
    }

    class Pelicula {
