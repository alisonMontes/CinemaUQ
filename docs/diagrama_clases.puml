        + setNumero(numero : String) : void
        + getSaldo() : double
        + setSaldo(saldo : double) : void
        + getEstado() : EstadoTarjeta
        + setEstado(estado : EstadoTarjeta) : void
        + getMovimientos() : List<MovimientoTarjeta>
        + toString() : String
    }

    class MovimientoTarjeta {
        - tipo : TipoMovimiento
